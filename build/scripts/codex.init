VERSION=0.153.0
curl -L https://releases.openai.com/codex/releases/${VERSION}/codex-package-x86_64-unknown-linux-musl.tar.gz -o /tmp/codex.tar.gz

mkdir -p $HOME/.codex/standalone/
tar -xvzf /tmp/codex.tar.gz -C ~/.codex/standalone/
ln -sf $HOME/.codex/standalone/bin/codex $HOME/bin/codex
